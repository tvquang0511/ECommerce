# user-service
PORT=4001
NODE_ENV=development

# Postgres from infra/docker-compose.dev.yml (host port 5432)
# DB strategy: one Postgres instance, multiple per-service databases.
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/user?schema=public

# CORS (needed if you want cookie-based refresh from Next.js)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Password hashing
BCRYPT_ROUNDS=10

# Refresh cookie
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/users/auth

# Used for building reset-password links (dev)
APP_WEB_URL=http://localhost:3000

# user-service
PORT=4001
NODE_ENV=development

# Postgres from infra/docker/docker-compose.dev.yml (host port 5432)
# DB strategy: one Postgres instance, multiple per-service databases.
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/user?schema=public

# CORS (needed if you want cookie-based refresh from Next.js)
CORS_ORIGIN=http://localhost:3000

# JWT access token (RS256)
# Recommended: base64-encoded PEM to avoid multi-line env issues.
# JWT_ACCESS_PRIVATE_KEY_PEM_B64=<base64 of pkcs8 private key pem>
# JWT_ACCESS_PUBLIC_KEY_PEM_B64=<base64 of spki public key pem>
# (Alternatively you can set *_PEM directly with literal \n)
# JWT_ACCESS_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_ACCESS_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_ACCESS_TTL=15m

# Refresh token (opaque) server-side pepper
REFRESH_TOKEN_PEPPER=dev-refresh-pepper
JWT_REFRESH_TTL=7d

# 2FA OTP (email) TTL
TWO_FACTOR_OTP_TTL_SECONDS=120

# Email verification link TTL
EMAIL_VERIFICATION_TTL_SECONDS=900

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_username
# SMTP_PASS=your_password
# SMTP_FROM="Ecommerce <no-reply@example.com>"

# Password hashing
BCRYPT_ROUNDS=10

# Refresh cookie
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/users/auth

# Used for building public auth links such as email verification and reset password.
# In local development, point this to the host that can reach `/api/users/auth/*`.
APP_WEB_URL=http://localhost:3000

# MinIO (avatar storage)
# Matches infra/docker/docker-compose.dev.yml defaults.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123456
MINIO_PUBLIC_BUCKET=user-public
MINIO_PUBLIC_URL=http://localhost:9000

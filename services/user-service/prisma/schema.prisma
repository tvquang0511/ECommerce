generator client {
  provider = "prisma-client-js"
  output   = "./.client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  emailVerifiedAt DateTime?

  bio         String?
  dateOfBirth DateTime?
  phoneNumber String?  @unique
  gender      Gender?

  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RBAC relations
  roles          UserRole[]
  permissions    UserPermission[]
  sellerProfile  SellerProfile?

  refreshTokens       RefreshToken[]
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  emailOtps           EmailOtp[]

  auditLogsAsActor AuditLog[] @relation("AuditLogActor")
  auditLogsAsTarget AuditLog[] @relation("AuditLogTarget")

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String

  actorUserId  String?
  targetUserId String?
  sessionId    String?

  ip        String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  actorUser  User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Multi-device session.
// One user can have multiple sessions (devices/browsers). Each session can have many refresh tokens over time (rotation chain).
model AuthSession {
  id     String @id @default(cuid())
  userId String

  revokedAt DateTime?
  lastUsedAt DateTime?

  createdByIp        String?
  createdByUserAgent String?
  lastUsedIp         String?
  lastUsedUserAgent  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  sessionId String

  // Opaque refresh token format: <tokenId>.<secret>
  // - tokenId is used for lookup
  // - tokenHash is hash(secret + pepper)
  tokenId   String   @unique
  tokenHash String   @unique

  replacedByTokenId String?
  lastUsedAt        DateTime?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

enum EmailOtpPurpose {
  LOGIN_2FA
  EMAIL_VERIFICATION
}

model EmailOtp {
  id        String          @id @default(uuid())
  userId    String
  purpose   EmailOtpPurpose
  codeHash  String
  expiresAt DateTime

  consumedAt DateTime?
  attempts   Int      @default(0)

  requestedIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_otps")
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============ RBAC Models ============

enum RoleEnum {
  BUYER
  SELLER
  ADMIN_MODERATOR
  ADMIN_OPERATIONS
  ADMIN_ANALYTICS
  SUPER_ADMIN
}

enum SellerStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  BANNED
}

enum SellerTier {
  INDIVIDUAL
  MERCHANT
  BRAND_PARTNER
  PREMIUM
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isPublic    Boolean  @default(true)
  
  permissions RolePermission[]
  users       UserRole[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  expiresAt DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String   // "product", "seller", "admin"
  
  roles       RolePermission[]
  users       UserPermission[]
  
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  assignedAt   DateTime @default(now())
  expiresAt    DateTime?
  
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model SellerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  shopName      String   @unique
  shopDesc      String?
  
  status        SellerStatus @default(PENDING_VERIFICATION)
  
  tier          SellerTier @default(INDIVIDUAL)
  isKycVerified Boolean   @default(false)
  
  totalProducts Int       @default(0)
  totalOrders   Int       @default(0)
  avgRating     Float?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([status])
  @@index([userId])
  @@map("seller_profiles")
}

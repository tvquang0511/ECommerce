# ====== Product Subgraph Config ======
# Tất cả env vars cho product-subgraph service

# Application
PORT=4002
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<db_username>:[YOUR_MONGO_PASSWORD]@ecommerce-product.uevz5qr.mongodb.net/product-subgraph?appName=ecommerce-product

# External Services
USER_SERVICE_BASE_URL=http://localhost:4001

# Auth (calls to user-service)
AUTH_REQUEST_TIMEOUT_MS=5000

# Auth: JWT public key from user-service (RS256 verification)
# This MUST match JWT_ACCESS_PUBLIC_KEY_PEM_B64 in user-service/.env
JWT_PRODUCT_PUBLIC_KEY_PEM_B64=REPLACE_WITH_BASE64_PUBLIC_KEY

# Test only: allow x-dev-* headers
AUTH_ALLOW_TEST_HEADERS=false

# Redis cache
REDIS_URL=rediss://default:@improved-bluegill-97879.upstash.io:6379
PRODUCT_LIST_CACHE_TTL=300
PRODUCT_DETAIL_CACHE_TTL=600

# MinIO (product media)
MINIO_ENDPOINT=wrhnagdlbgrysznkimbw.storage.supabase.co/storage/v1/s3
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=[YOUR_S3_ACCESS_KEY]
MINIO_SECRET_KEY=[YOUR_S3_SECRET_KEY]
MINIO_PRIVATE_BUCKET=product-private
MINIO_PRESIGN_EXPIRY_SECONDS=600

{
  "info": {
    "name": "Product Subgraph API",
    "_postman_id": "product-subgraph-collection",
    "description": "Collection for testing product-subgraph endpoints (local dev).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-dev-user-id",
            "value": "{{devUserId}}"
          },
          {
            "key": "x-dev-roles",
            "value": "{{devRoles}}"
          },
          {
            "key": "x-dev-seller-status",
            "value": "{{devSellerStatus}}"
          },
          {
            "key": "x-dev-kyc-verified",
            "value": "{{devKycVerified}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-dev-user-id",
            "value": "{{devUserId}}"
          },
          {
            "key": "x-dev-roles",
            "value": "{{devRoles}}"
          },
          {
            "key": "x-dev-seller-status",
            "value": "{{devSellerStatus}}"
          },
          {
            "key": "x-dev-kyc-verified",
            "value": "{{devKycVerified}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Desk\",\n  \"price\": 120,\n  \"categoryId\": \"cat-desks\",\n  \"tags\": [\"furniture\"],\n  \"attributes\": { \"color\": \"oak\" }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-dev-user-id",
            "value": "{{devUserId}}"
          },
          {
            "key": "x-dev-roles",
            "value": "{{devRoles}}"
          },
          {
            "key": "x-dev-seller-status",
            "value": "{{devSellerStatus}}"
          },
          {
            "key": "x-dev-kyc-verified",
            "value": "{{devKycVerified}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products","{{productId}}"]
        }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-dev-user-id",
            "value": "{{devUserId}}"
          },
          {
            "key": "x-dev-roles",
            "value": "{{devRoles}}"
          },
          {
            "key": "x-dev-seller-status",
            "value": "{{devSellerStatus}}"
          },
          {
            "key": "x-dev-kyc-verified",
            "value": "{{devKycVerified}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mechanical Desk\",\n  \"price\": 150,\n  \"tags\": [\"furniture\", \"workstation\"],\n  \"attributes\": { \"color\": \"walnut\" }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products","{{productId}}"]
        }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "x-dev-user-id",
            "value": "{{devUserId}}"
          },
          {
            "key": "x-dev-roles",
            "value": "{{devRoles}}"
          },
          {
            "key": "x-dev-seller-status",
            "value": "{{devSellerStatus}}"
          },
          {
            "key": "x-dev-kyc-verified",
            "value": "{{devKycVerified}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products","{{productId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4002",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "devUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "devRoles",
      "value": "SELLER",
      "type": "string"
    },
    {
      "key": "devSellerStatus",
      "value": "VERIFIED",
      "type": "string"
    },
    {
      "key": "devKycVerified",
      "value": "true",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "p1",
      "type": "string"
    }
  ]
}

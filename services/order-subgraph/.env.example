# Application
PORT=4004
NODE_ENV=development

# Auth
USER_SERVICE_BASE_URL=http://localhost:4001
AUTH_REQUEST_TIMEOUT_MS=5000
JWT_ORDER_PUBLIC_KEY_PEM_
AUTH_ALLOW_TEST_HEADERS=false

# Order
ORDER_DEFAULT_CURRENCY=VND
CART_SUBGRAPH_BASE_URL=http://localhost:4003
PRODUCT_SUBGRAPH_BASE_URL=http://localhost:4002
INVENTORY_SERVICE_BASE_URL=http://localhost:4010

# Future persistence / messaging
ORDER_DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/order
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=1000
OUTBOX_WORKER_BATCH_SIZE=20

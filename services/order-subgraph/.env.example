# ====== Order Subgraph Config ======

# Application
PORT=4004
NODE_ENV=development

# Auth
USER_SERVICE_BASE_URL=http://localhost:4001
AUTH_REQUEST_TIMEOUT_MS=5000
JWT_ORDER_PUBLIC_KEY_PEM_B64=REPLACE_WITH_BASE64_PUBLIC_KEY
AUTH_ALLOW_TEST_HEADERS=false

# Order
ORDER_DEFAULT_CURRENCY=VND
CART_SUBGRAPH_BASE_URL=http://localhost:4003
PRODUCT_SUBGRAPH_BASE_URL=http://localhost:4002

# Future persistence / messaging
ORDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ====== Cart Subgraph Config ======
# Tất cả env vars cho cart-subgraph service

# Application
PORT=4003
NODE_ENV=development

# External Services
USER_SERVICE_BASE_URL=http://localhost:4001
PRODUCT_SUBGRAPH_BASE_URL=http://localhost:4002

# Auth (calls to user-service)
AUTH_REQUEST_TIMEOUT_MS=5000

# Auth: JWT public key from user-service (RS256 verification)
# This MUST match JWT_ACCESS_PUBLIC_KEY_PEM_B64 in user-service/.env
JWT_CART_PUBLIC_KEY_PEM_B64=REPLACE_WITH_BASE64_PUBLIC_KEY

# Test only: allow x-dev-* headers
AUTH_ALLOW_TEST_HEADERS=false

# (Future) Redis primary store
REDIS_URL="rediss://default:[YOUR_UPSTASH_PASSWORD]@improved-bluegill-97879.upstash.io:6379"

# Limit distinct items in cart. Default: 99
CART_MAX_DISTINCT_ITEMS=99
